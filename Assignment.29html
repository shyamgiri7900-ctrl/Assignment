Q.29 Style a landing-page hero section using position and z-index.

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hero Section Design</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f8fafc;
            color: #172033;
        }

        /* Navigation */
        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 22px 8%;
            background: white;
            position: relative;
            z-index: 10;
        }

        .logo {
            font-size: 25px;
            font-weight: bold;
            color: #4f46e5;
        }

        nav a {
            text-decoration: none;
            color: #334155;
            margin-left: 22px;
        }

        /* Hero section */
        .hero {
            min-height: 520px;
            padding: 80px 8%;
            display: flex;
            align-items: center;
            position: relative;
            overflow: hidden;
            background: #eef2ff;
        }

        /* Decorative background shape */
        .hero-shape {
            position: absolute;
            width: 420px;
            height: 420px;
            background: #c7d2fe;
            border-radius: 50%;
            right: -80px;
            top: 40px;
            z-index: 0;
        }

        /* Main text */
        .hero-content {
            position: relative;
            z-index: 2;
            max-width: 560px;
        }

        .hero-content h1 {
            font-size: clamp(36px, 5vw, 58px);
            line-height: 1.1;
            margin-bottom: 20px;
        }

        .hero-content h1 span {
            color: #4f46e5;
        }

        .hero-content p {
            font-size: 17px;
            line-height: 1.7;
            color: #475569;
            margin-bottom: 28px;
        }

        .hero-content button {
            background: #4f46e5;
            color: white;
            border: none;
            padding: 14px 25px;
            border-radius: 8px;
            font-size: 16px;
            cursor: pointer;
        }

        /* Floating card */
        .floating-card {
            position: absolute;
            z-index: 3;
            right: 12%;
            bottom: 70px;
            width: 230px;
            padding: 24px;
            border-radius: 16px;
            background: white;
            box-shadow: 0 15px 40px #3730a333;
        }

        .floating-card h3 {
            margin-bottom: 10px;
            color: #4f46e5;
        }

        .floating-card p {
            color: #475569;
            line-height: 1.5;
        }

        /* Mobile layout */
        @media (max-width: 700px) {
            nav {
                padding: 18px 5%;
            }

            nav a {
                margin-left: 8px;
                font-size: 13px;
            }

            .hero {
                padding: 60px 6% 280px;
            }

            .hero-shape {
                width: 260px;
                height: 260px;
                right: -100px;
                top: auto;
                bottom: 20px;
            }

            .floating-card {
                left: 6%;
                right: auto;
                bottom: 35px;
                width: 210px;
            }
        }
    </style>
</head>

<body>

    <nav>
        <div class="logo">Creative.</div>

        <div>
            <a href="#home">Home</a>
            <a href="#about">About</a>
        </div>
    </nav>

    <section class="hero" id="home">

        <div class="hero-shape"></div>

        <div class="hero-content">
            <h1>Build Your <span>Dream</span> Website</h1>

            <p>
                Create beautiful digital experiences with modern
                design, creative ideas and powerful technology.
            </p>

            <button onclick="alert('Welcome!')">
                Get Started
            </button>
        </div>

        <div class="floating-card" id="about">
            <h3>Creative Design</h3>
            <p>Make your ideas stand out with a clean, modern layout.</p>
        </div>

    </section>

</body>
</html>
