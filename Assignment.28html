Q.28 Fix a supplied page where overflow is breaking the layout.

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Overflow Fixed Page</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f1f5f9;
            color: #1e293b;
            overflow-x: hidden;
        }

        header {
            background: #2563eb;
            color: white;
            padding: 20px;
            text-align: center;
        }

        .container {
            width: 100%;
            max-width: 1100px;
            margin: 30px auto;
            padding: 0 20px;

            /* Prevent children from exceeding container */
            min-width: 0;
        }

        .card-container {
            display: grid;
            grid-template-columns:
                repeat(3, minmax(0, 1fr));
            gap: 20px;
        }

        .card {
            background: white;
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 4px 12px #00000010;

            /* Allow long content to wrap */
            min-width: 0;
            overflow-wrap: anywhere;
        }

        .card h2 {
            margin-bottom: 12px;
        }

        .card p {
            line-height: 1.6;
        }

        .card img {
            display: block;
            max-width: 100%;
            height: auto;
            border-radius: 8px;
        }

        pre {
            max-width: 100%;
            overflow-x: auto;
            white-space: pre-wrap;
            overflow-wrap: anywhere;
        }

        footer {
            margin-top: 30px;
            padding: 20px;
            background: #1e293b;
            color: white;
            text-align: center;
        }

        /* Responsive layout */
        @media (max-width: 768px) {
            .card-container {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @media (max-width: 480px) {
            .card-container {
                grid-template-columns: 1fr;
            }

            .container {
                padding: 0 12px;
            }
        }
    </style>
</head>

<body>

    <header>
        <h1>My Responsive Page</h1>
    </header>

    <main class="container">
        <div class="card-container">

            <section class="card">
                <h2>Card One</h2>
                <p>This card fits inside its container without breaking the layout.</p>
            </section>

            <section class="card">
                <h2>Card Two</h2>
                <p>Long content can wrap onto multiple lines instead of overflowing.</p>
            </section>

            <section class="card">
                <h2>Card Three</h2>
                <p>The grid automatically adjusts for tablets and mobile screens.</p>
            </section>

        </div>
    </main>

    <footer>
        <p>Overflow Fixed Successfully</p>
    </footer>

</body>
</html>
