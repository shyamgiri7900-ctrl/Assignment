Q.45 Submit the finished, fully responsive landing-page project.

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Launchify helps teams turn great ideas into successful projects.">
  <title>Launchify | Build Something Great</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <header class="site-header">
    <nav class="navbar container" aria-label="Main navigation">
      <a class="logo" href="#home">Launchify<span>.</span></a>

      <div class="nav-links">
        <a href="#home">Home</a>
        <a href="#features">Features</a>
        <a href="#about">About</a>
      </div>

      <a class="button button-small nav-cta" href="#contact">Get Started</a>
    </nav>
  </header>

  <main>
    <section class="hero container" id="home">
      <div class="hero-content">
        <p class="eyebrow">YOUR NEXT BIG IDEA STARTS HERE</p>
        <h1>Build something <span>amazing.</span></h1>
        <p class="hero-description">
          Bring your ideas to life with simple tools, smart workflows,
          and a team ready to make a difference.
        </p>
        <div class="hero-actions">
          <a class="button" href="#features">Explore Features</a>
          <a class="text-link" href="#about">Learn more →</a>
        </div>
        <div class="trust-note">
          <span class="status-dot"></span>
          A smarter way to start your next project
        </div>
      </div>

      <div class="hero-visual" aria-label="Project planning illustration">
        <div class="visual-glow"></div>
        <div class="dashboard-card">
          <div class="dashboard-top">
            <span class="window-dots">● ● ●</span>
            <span class="dashboard-label">PROJECT OVERVIEW</span>
          </div>
          <div class="progress-heading">
            <div>
              <p class="muted">Weekly progress</p>
              <h2>You're on track!</h2>
            </div>
            <span class="progress-badge">+24%</span>
          </div>
          <div class="chart" aria-label="Illustrative weekly progress chart">
            <span style="height: 35%"></span>
            <span style="height: 55%"></span>
            <span style="height: 45%"></span>
            <span style="height: 72%"></span>
            <span style="height: 62%"></span>
            <span style="height: 88%"></span>
            <span style="height: 100%"></span>
          </div>
          <div class="chart-labels">
            <span>Mon</span><span>Tue</span><span>Wed</span>
            <span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
          </div>
          <div class="task-list">
            <div class="task">
              <span class="task-icon purple">✓</span>
              <div><strong>Design system</strong><small>Completed</small></div>
              <span class="task-status">Done</span>
            </div>
            <div class="task">
              <span class="task-icon orange">↗</span>
              <div><strong>Website launch</strong><small>In progress</small></div>
              <span class="task-status active">Active</span>
            </div>
          </div>
        </div>
        <div class="floating-note">
          <span class="floating-icon">✦</span>
          <div><strong>Great work!</strong><small>Keep the momentum going</small></div>
        </div>
      </div>
    </section>

    <section class="features section" id="features">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">WHY LAUNCHIFY?</p>
          <h2>Everything you need to <span>move forward.</span></h2>
          <p>Simple, practical features to help turn plans into progress.</p>
        </div>

        <div class="feature-grid">
          <article class="feature-card">
            <div class="feature-icon icon-purple">✦</div>
            <h3>Simple workflow</h3>
            <p>Keep your work organised with a clear, easy-to-follow process.</p>
            <a href="#contact">Learn more →</a>
          </article>

          <article class="feature-card">
            <div class="feature-icon icon-orange">↗</div>
            <h3>Faster progress</h3>
            <p>Focus on important tasks and spend less time on busywork.</p>
            <a href="#contact">Learn more →</a>
          </article>

          <article class="feature-card">
            <div class="feature-icon icon-green">✓</div>
            <h3>Better teamwork</h3>
            <p>Bring people together and keep everyone moving in one direction.</p>
            <a href="#contact">Learn more →</a>
          </article>
        </div>
      </div>
    </section>

    <section class="about-section section" id="about">
      <div class="container about-content">
        <div>
          <p class="eyebrow">MADE FOR YOUR NEXT CHAPTER</p>
          <h2>Start small. Think big.</h2>
        </div>
        <p>
          Great projects begin with a clear first step. Create a plan,
          build momentum, and keep improving as you go.
        </p>
        <a class="button" href="#contact">Let's get started</a>
      </div>
    </section>

    <section class="contact-section section" id="contact">
      <div class="container contact-content">
        <p class="eyebrow">READY TO BEGIN?</p>
        <h2>Your next idea deserves a great start.</h2>
        <p>Take the first step and see what you can create.</p>
        <a class="button button-light" href="mailto:hello@example.com">Contact Us</a>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-content">
      <a class="logo" href="#home">Launchify<span>.</span></a>
      <p>© 2026 Launchify. Created for learning and practice.</p>
      <a href="#home">Back to top ↑</a>
    </div>
  </footer>
</body>
</html>
