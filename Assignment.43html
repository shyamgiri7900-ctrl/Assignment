Q.43 Recreate a simple reference landing page using both Grid and Flexbox appropriately.

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Modern Landing Page</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      color: #172033;
      background: #f8fafc;
      line-height: 1.6;
    }

    a {
      text-decoration: none;
    }

    /* FLEXBOX: Navigation */
    .navbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 18px;
      padding: 20px 8%;
      background: white;
    }

    .logo {
      color: #4f46e5;
      font-size: 25px;
      font-weight: bold;
    }

    .nav-links {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 24px;
      list-style: none;
    }

    .nav-links a {
      color: #334155;
    }

    .nav-links a:hover {
      color: #4f46e5;
    }

    /* GRID: Hero section */
    .hero {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: center;
      gap: 45px;
      padding: 75px 8%;
      background: #eef2ff;
    }

    /* FLEXBOX: Hero content */
    .hero-content {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }

    .hero-content h1 {
      font-size: clamp(34px, 5vw, 56px);
      line-height: 1.15;
    }

    .hero-content p {
      max-width: 480px;
      color: #64748b;
      font-size: 17px;
    }

    .hero-buttons {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-block;
      padding: 12px 22px;
      border-radius: 8px;
      font-weight: bold;
    }

    .btn-primary {
      background: #4f46e5;
      color: white;
    }

    .btn-secondary {
      color: #4f46e5;
      border: 1px solid #4f46e5;
    }

    .hero-visual {
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 280px;
      border-radius: 24px;
      background: linear-gradient(135deg, #c7d2fe, #ddd6fe);
      font-size: 100px;
    }

    /* GRID: Feature cards */
    .features {
      padding: 65px 8%;
    }

    .section-heading {
      text-align: center;
      margin-bottom: 35px;
    }

    .section-heading h2 {
      font-size: 32px;
      margin-bottom: 8px;
    }

    .section-heading p {
      color: #64748b;
    }

    .feature-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px;
    }

    .feature-card {
      padding: 28px;
      background: white;
      border: 1px solid #e2e8f0;
      border-radius: 14px;
      transition: transform 0.25s ease;
    }

    .feature-card:hover {
      transform: translateY(-5px);
    }

    .feature-icon {
      font-size: 34px;
      margin-bottom: 12px;
    }

    .feature-card h3 {
      margin-bottom: 10px;
    }

    .feature-card p {
      color: #64748b;
    }

    /* FLEXBOX: Footer */
    .footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 15px;
      padding: 25px 8%;
      background: #172033;
      color: white;
    }

    .footer a {
      color: #c7d2fe;
    }

    /* Responsive: Tablet */
    @media (max-width: 900px) {
      .hero {
        gap: 25px;
        padding: 55px 6%;
      }

      .feature-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    /* Responsive: Mobile */
    @media (max-width: 600px) {
      .navbar {
        justify-content: center;
        padding: 18px 5%;
      }

      .nav-links {
        justify-content: center;
        gap: 14px;
      }

      .hero {
        grid-template-columns: minmax(0, 1fr);
        padding: 45px 6%;
        text-align: center;
      }

      .hero-content {
        align-items: center;
      }

      .hero-content p {
        font-size: 16px;
      }

      .hero-buttons {
        justify-content: center;
      }

      .hero-visual {
        min-height: 220px;
        width: 100%;
      }

      .features {
        padding: 45px 6%;
      }

      .feature-grid {
        grid-template-columns: minmax(0, 1fr);
      }

      .section-heading h2 {
        font-size: 27px;
      }

      .footer {
        justify-content: center;
        text-align: center;
      }
    }
  </style>
</head>

<body>

  <header class="navbar">
    <a href="#home" class="logo">Launchify</a>

    <nav aria-label="Main navigation">
      <ul class="nav-links">
        <li><a href="#home">Home</a></li>
        <li><a href="#features">Features</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <section class="hero" id="home">
      <div class="hero-content">
        <h1>Build Your Next Big Idea</h1>

        <p>
          Create beautiful digital experiences with a modern,
          responsive design that works on every device.
        </p>

        <div class="hero-buttons">
          <a href="#features" class="btn btn-primary">Get Started</a>
          <a href="#about" class="btn btn-secondary">Learn More</a>
        </div>
      </div>

      <div class="hero-visual" aria-label="Rocket illustration">
        🚀
      </div>
    </section>

    <section class="features" id="features">
      <div class="section-heading">
        <h2>Why Choose Us?</h2>
        <p>Everything you need to get started.</p>
      </div>

      <div class="feature-grid">
        <article class="feature-card">
          <div class="feature-icon">🎨</div>
          <h3>Modern Design</h3>
          <p>Enjoy a clean interface with consistent colours and spacing.</p>
        </article>

        <article class="feature-card" id="about">
          <div class="feature-icon">📱</div>
          <h3>Responsive Layout</h3>
          <p>Our layout adapts to desktops, tablets and mobile screens.</p>
        </article>

        <article class="feature-card">
          <div class="feature-icon">⚡</div>
          <h3>Easy to Use</h3>
          <p>Simple layouts make the experience clear and intuitive.</p>
        </article>
      </div>
    </section>
  </main>

  <footer class="footer" id="contact">
    <p>© 2026 Launchify. All rights reserved.</p>
    <a href="#home">Back to top ↑</a>
  </footer>

</body>
</html>
