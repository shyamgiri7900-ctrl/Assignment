Q.42 Audit and fix responsiveness issues in one earlier project.

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Responsive ShopZone</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      background: #f4f6f9;
      color: #1e293b;
      line-height: 1.5;
    }

    img {
      display: block;
      max-width: 100%;
    }

    button,
    input {
      font: inherit;
    }

    /* Main layout */
    .layout {
      display: grid;
      grid-template-columns: 230px minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      grid-template-areas:
        "header header"
        "sidebar main";
      min-height: 100vh;
    }

    /* Header */
    .header {
      grid-area: header;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
      padding: 16px 24px;
      background: white;
      border-bottom: 1px solid #e2e8f0;
    }

    .logo {
      color: #5145cd;
      font-size: 24px;
      font-weight: bold;
    }

    .search {
      width: min(100%, 350px);
      min-width: 0;
      padding: 10px 12px;
      border: 1px solid #cbd5e1;
      border-radius: 8px;
    }

    /* Sidebar */
    .sidebar {
      grid-area: sidebar;
      min-width: 0;
      padding: 24px 18px;
      background: white;
      border-right: 1px solid #e2e8f0;
    }

    .sidebar h2 {
      font-size: 18px;
      margin-bottom: 16px;
    }

    .sidebar label {
      display: block;
      margin-bottom: 14px;
      overflow-wrap: anywhere;
      color: #475569;
      cursor: pointer;
    }

    .sidebar input {
      margin-right: 6px;
    }

    /* Main content */
    .main {
      grid-area: main;
      min-width: 0;
      padding: 28px;
    }

    .main h1 {
      font-size: clamp(22px, 3vw, 30px);
      margin-bottom: 8px;
    }

    .description {
      color: #64748b;
      margin-bottom: 24px;
    }

    /* Product grid */
    .product-grid {
      display: grid;
      grid-template-columns:
        repeat(auto-fit, minmax(min(100%, 220px), 1fr));
      gap: 20px;
    }

    .product-card {
      min-width: 0;
      overflow: hidden;
      background: white;
      border-radius: 12px;
      box-shadow: 0 3px 12px #0000000a;
    }

    .product-card img {
      width: 100%;
      height: 200px;
      object-fit: cover;
    }

    .product-info {
      padding: 16px;
    }

    .product-info h2 {
      font-size: 18px;
      margin-bottom: 8px;
      overflow-wrap: anywhere;
    }

    .product-info p {
      color: #64748b;
      font-size: 14px;
      margin-bottom: 12px;
    }

    .price {
      color: #15803d;
      font-size: 20px;
      font-weight: bold;
      margin-bottom: 14px;
    }

    .buy-btn {
      width: 100%;
      min-height: 42px;
      padding: 10px;
      border: none;
      border-radius: 7px;
      color: white;
      background: #5145cd;
      cursor: pointer;
    }

    .buy-btn:hover {
      background: #3d32a8;
    }

    .buy-btn:focus-visible,
    .search:focus-visible {
      outline: 3px solid #a5b4fc;
      outline-offset: 3px;
    }

    /* Tablet: 900px and below */
    @media (max-width: 900px) {
      .layout {
        grid-template-columns: 190px minmax(0, 1fr);
      }

      .main {
        padding: 20px;
      }

      .product-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
      }

      .product-card img {
        height: 180px;
      }
    }

    /* Mobile: 600px and below */
    @media (max-width: 600px) {
      .layout {
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: auto auto 1fr;
        grid-template-areas:
          "header"
          "sidebar"
          "main";
      }

      .header {
        padding: 16px;
      }

      .logo {
        font-size: 21px;
      }

      .search {
        flex-basis: 100%;
        width: 100%;
        max-width: none;
      }

      .sidebar {
        padding: 16px;
        border-right: none;
        border-bottom: 1px solid #e2e8f0;
      }

      .sidebar label {
        display: inline-block;
        margin: 0 12px 8px 0;
      }

      .main {
        padding: 16px;
      }

      .product-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
      }

      .product-card img {
        height: clamp(110px, 35vw, 165px);
      }

      .product-info {
        padding: 12px;
      }

      .product-info h2 {
        font-size: 16px;
      }

      .price {
        font-size: 17px;
      }
    }

    /* Extra-small screens */
    @media (max-width: 350px) {
      .product-grid {
        grid-template-columns: minmax(0, 1fr);
      }

      .product-card img {
        height: 200px;
      }
    }
  </style>
</head>

<body>
  <div class="layout">

    <header class="header">
      <div class="logo">ShopZone</div>
      <input
        class="search"
        type="search"
        placeholder="Search products..."
        aria-label="Search products"
      >
    </header>

    <aside class="sidebar">
      <h2>Categories</h2>

      <label><input type="checkbox"> Electronics</label>
      <label><input type="checkbox"> Fashion</label>
      <label><input type="checkbox"> Accessories</label>
      <label><input type="checkbox"> Home & Living</label>
    </aside>

    <main class="main">
      <h1>Our Products</h1>
      <p class="description">
        Discover our latest products and special offers.
      </p>

      <section class="product-grid">

        <article class="product-card">
          <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=500"
               alt="Wireless headphones">
          <div class="product-info">
            <h2>Headphones</h2>
            <p>High-quality sound for everyday listening.</p>
            <div class="price">₹1,499</div>
            <button class="buy-btn">View Product</button>
          </div>
        </article>

        <article class="product-card">
          <img src="https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=500"
               alt="Classic wristwatch">
          <div class="product-info">
            <h2>Wristwatch</h2>
            <p>A timeless accessory for any occasion.</p>
            <div class="price">₹2,299</div>
            <button class="buy-btn">View Product</button>
          </div>
        </article>

        <article class="product-card">
          <img src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=500"
               alt="Red sports shoe">
          <div class="product-info">
            <h2>Sports Shoes</h2>
            <p>Comfortable footwear for active days.</p>
            <div class="price">₹1,899</div>
            <button class="buy-btn">View Product</button>
          </div>
        </article>

        <article class="product-card">
          <img src="https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f?w=500"
               alt="Vintage camera">
          <div class="product-info">
            <h2>Camera</h2>
            <p>Capture memorable moments in style.</p>
            <div class="price">₹5,499</div>
            <button class="buy-btn">View Product</button>
          </div>
        </article>

      </section>
    </main>

  </div>
</body>
</html>
