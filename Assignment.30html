Q.30 Submit the finished profile-card / product-card component.

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile and Product Cards</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f1f5f9;
            color: #1e293b;
            padding: 40px 20px;
        }

        h1 {
            text-align: center;
            margin-bottom: 35px;
        }

        .card-container {
            display: flex;
            justify-content: center;
            align-items: stretch;
            flex-wrap: wrap;
            gap: 30px;
        }

        .card {
            width: 300px;
            background: white;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 6px 20px #00000012;
            transition: transform 0.3s, box-shadow 0.3s;
        }

        .card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 28px #00000020;
        }

        /* Profile Card */
        .profile-header {
            background: #4f46e5;
            height: 100px;
        }

        .profile-content {
            padding: 0 24px 25px;
            text-align: center;
        }

        .avatar {
            width: 100px;
            height: 100px;
            margin: -50px auto 15px;
            border: 5px solid white;
            border-radius: 50%;
            background: #c7d2fe;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 38px;
        }

        .profile-content h2 {
            margin-bottom: 8px;
        }

        .role {
            color: #6366f1;
            font-weight: bold;
            margin-bottom: 14px;
        }

        .description {
            color: #64748b;
            line-height: 1.6;
            margin-bottom: 20px;
        }

        /* Product Card */
        .product-image {
            height: 190px;
            background: #e0e7ff;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 75px;
        }

        .product-content {
            padding: 22px;
        }

        .tag {
            display: inline-block;
            background: #dcfce7;
            color: #166534;
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 12px;
            margin-bottom: 12px;
        }

        .product-content h2 {
            margin-bottom: 10px;
        }

        .product-description {
            color: #64748b;
            line-height: 1.5;
            margin-bottom: 15px;
        }

        .price {
            font-size: 24px;
            font-weight: bold;
            margin-bottom: 18px;
            color: #0f172a;
        }

        .btn {
            display: inline-block;
            background: #4f46e5;
            color: white;
            padding: 11px 20px;
            border: none;
            border-radius: 8px;
            text-decoration: none;
            font-size: 15px;
            cursor: pointer;
        }

        .btn:hover {
            background: #3730a3;
        }

        .product-btn {
            width: 100%;
        }

        footer {
            text-align: center;
            margin-top: 40px;
            color: #64748b;
            font-size: 14px;
        }

        @media (max-width: 480px) {
            body {
                padding: 25px 15px;
            }

            .card {
                width: 100%;
                max-width: 340px;
            }
        }
    </style>
</head>

<body>

    <h1>Card Components</h1>

    <main class="card-container">

        <!-- Profile Card -->
        <article class="card">
            <div class="profile-header"></div>

            <div class="profile-content">
                <div class="avatar" aria-label="Profile icon">
                    👨‍💻
                </div>

                <h2>Rahul Sharma</h2>
                <p class="role">Web Developer</p>

                <p class="description">
                    I enjoy building responsive websites and
                    learning modern web technologies.
                </p>

                <a class="btn" href="mailto:hello@example.com">
                    Contact Me
                </a>
            </div>
        </article>

        <!-- Product Card -->
        <article class="card">
            <div class="product-image" role="img"
                 aria-label="Laptop illustration">
                💻
            </div>

            <div class="product-content">
                <span class="tag">Featured Product</span>

                <h2>Smart Laptop</h2>

                <p class="product-description">
                    A versatile laptop for study, coding
                    and everyday productivity.
                </p>

                <p class="price">₹49,999</p>

                <button class="btn product-btn"
                        onclick="alert('Product added to cart!')">
                    Add to Cart
                </button>
            </div>
        </article>

    </main>

    <footer>
        <p>Profile Card &amp; Product Card | HTML and CSS Project</p>
    </footer>

</body>
</html>
