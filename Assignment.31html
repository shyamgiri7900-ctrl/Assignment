Q.31 Create a simple responsive menu bar using display:flex.

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Responsive Flex Menu</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f1f5f9;
        }

        /* Navigation bar */
        .navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
            padding: 18px 8%;
            background: #1e293b;
            color: white;
        }

        .logo {
            font-size: 24px;
            font-weight: bold;
            color: #38bdf8;
        }

        /* Menu links */
        .nav-links {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 25px;
            list-style: none;
        }

        .nav-links a {
            color: white;
            text-decoration: none;
            font-size: 16px;
            transition: color 0.3s;
        }

        .nav-links a:hover {
            color: #38bdf8;
        }

        /* Page content */
        .content {
            text-align: center;
            padding: 100px 20px;
        }

        .content h1 {
            margin-bottom: 15px;
            color: #1e293b;
        }

        .content p {
            color: #64748b;
            line-height: 1.6;
        }

        /* Mobile responsive */
        @media (max-width: 600px) {
            .navbar {
                flex-direction: column;
                padding: 20px;
            }

            .nav-links {
                justify-content: center;
                gap: 15px;
            }

            .nav-links a {
                font-size: 14px;
            }

            .content {
                padding: 60px 20px;
            }
        }
    </style>
</head>

<body>

    <nav class="navbar">
        <div class="logo">MyWebsite</div>

        <ul class="nav-links">
            <li><a href="#home">Home</a></li>
            <li><a href="#about">About</a></li>
            <li><a href="#services">Services</a></li>
            <li><a href="#contact">Contact</a></li>
        </ul>
    </nav>

    <main class="content" id="home">
        <h1>Welcome to My Website</h1>
        <p>A simple responsive navigation bar using CSS Flexbox.</p>
    </main>

</body>
</html>
